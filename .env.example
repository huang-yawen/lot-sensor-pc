# 浏览器在 localhost/127.0.0.1 打开时默认 local，在公网域名/IP 打开时默认 remote。
# 如需固定默认值，可设为 local 或 remote。
VITE_DEFAULT_CONNECTION_MODE=

# 本地开发后端。
VITE_LOCAL_API_BASE_URL=http://localhost:3000
VITE_LOCAL_WS_URL=ws://localhost:3000

# 默认通过 Nginx 同源反向代理访问，不直接向公网暴露 Node 的 3000 端口。
# 如确实需要直连 Node，可将两项改为带 :3000 的地址。
VITE_REMOTE_API_BASE_URL=http://101.133.232.20
VITE_REMOTE_WS_URL=ws://101.133.232.20

# MQTT Broker 地址不在前端配置，只有配置中心页面的 MQTT_URL 一处生效，
# 本地/远程开关不会读取、也不会改写它。
