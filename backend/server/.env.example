# 复制为 .env 使用。这里只放部署 / 机密参数。
# 场景参数（MQTT 地址主题、字段映射、各控制模块开关阈值等）改为代码常量，
# 见 config/*.js 和各 service/<模块>/config.js，清单在 config/systemConfig.js 顶部、
# 速查在 CONFIG_CHEATSHEET.md。改本文件后需重启后端。

# ==================== 运行环境 ====================
PORT=3000
HOST=127.0.0.1
# production：全局错误处理器不返回内部错误细节（SQL / 路径等），只写日志。留空为开发模式。
NODE_ENV=
# 逗号分隔；只有明确可信的前端来源才应加入。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# 前端构建产物目录；留空时使用 <项目根>/dist
FRONTEND_DIST_PATH=

# ==================== API 认证（可选） ====================
# 留空＝不拦截（本地开发友好）。配置后所有 /api/ 请求需带 x-api-token 头或 ?token=，
# WebSocket 用 ws://.../ws?token=xxx。
API_TOKEN=

# ==================== 运行期文件位置（可选） ====================
# 离线暂存指令的持久化位置；留空时使用 server/data/pending-commands.json
PENDING_COMMANDS_FILE=

# ==================== 数据库 ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=task
DB_CONNECTION_LIMIT=10

# ==================== MQTT ====================
# 这里不再配置 MQTT。Broker 地址 / client id / 主题 / 账号密码统一在 config/mqtt.js 里改。
