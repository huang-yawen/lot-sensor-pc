# 复制为 .env 使用。仅存放部署 / 机密参数；场景参数（MQTT 主题、字段映射、阈值等）
# 一律在「场景配置」页面维护，见 CONFIG_CHEATSHEET.md。改本文件后需重启后端。

# ==================== 运行环境 ====================
PORT=3000
HOST=127.0.0.1
# production：全局错误处理器不返回内部错误细节（SQL / 路径等），只写日志。留空为开发模式。
NODE_ENV=
# 逗号分隔；只有明确可信的前端来源才应加入。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# 前端构建产物目录；留空时使用 <项目根>/dist
FRONTEND_DIST_PATH=

# ==================== API 认证（可选） ====================
# 留空＝不拦截（本地开发友好）。配置后所有 /api/ 请求需带 x-api-token 头或 ?token=，
# WebSocket 用 ws://.../ws?token=xxx。
API_TOKEN=

# ==================== 运行期文件位置（可选） ====================
# 离线暂存指令的持久化位置；留空时使用 server/data/pending-commands.json
PENDING_COMMANDS_FILE=
# 场景配置落盘位置；留空时使用 server/data/system-config.json
SYSTEM_CONFIG_FILE=

# ==================== 数据库 ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=task
DB_CONNECTION_LIMIT=10

# ==================== MQTT ====================
MQTT_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=lot-sensor-pc
MQTT_USERNAME=
MQTT_PASSWORD=
